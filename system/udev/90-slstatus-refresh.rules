# Refresh the slstatus bar when the charger is plugged or unplugged.
# Delayed 3 s so the battery status has time to update; AccuracySec=100ms
# stops systemd from coalescing the timer (its default window is 1 minute).
SUBSYSTEM=="power_supply", KERNEL=="AC", ACTION=="change", RUN+="/usr/bin/systemd-run --on-active=3 --timer-property=AccuracySec=100ms /usr/bin/pkill -USR1 -x slstatus"
